<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fr.vvlabs</groupId>
        <artifactId>poc-recherche-documentaire</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>recherche-documentaire-parser-marketplace</artifactId>
    <name>Recherche Documentaire - Parser Marketplace</name>
    <description>Regroupe tous les parsers OCR (tesseract, pdfbox, tika, markdown, xml/drawio)</description>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>fr.vvlabs</groupId>
            <artifactId>recherche-documentaire-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- tesseract -->
        <dependency>
            <groupId>net.sourceforge.tess4j</groupId>
            <artifactId>tess4j</artifactId>
            <version>5.20.0</version>
        </dependency>

        <!-- pdfbox (partage par pdfbox et tika) -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>

        <!-- tika -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parser-pdf-module</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parser-text-module</artifactId>
            <version>${tika.version}</version>
        </dependency>

        <!-- markdown -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>0.30.0</version>
        </dependency>

        <!-- xml/drawio : StAX + Inflater du JDK, jsoup fourni transitivement par core -->
    </dependencies>
</project>
